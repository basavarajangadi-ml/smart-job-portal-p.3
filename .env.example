# MongoDB Atlas or Local MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/smarthire

# JWT Authentication Secret Key (Generate with: openssl rand -base64 32)
AUTH_SECRET=super_secret_smarthire_jwt_key_change_in_production_2026

# Cloudinary Storage for Resumes (Optional in local dev - automatic fallback provided)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Next.js Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
